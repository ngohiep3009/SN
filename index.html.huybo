<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Kỷ Nguyên Phi Thăng - Ngọc Khánh Thượng Nhân</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Philosopher:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
    
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }

        body {
            /* Nền bồng lai tươi sáng: Trắng, Xanh ngọc, Hồng nhạt pha lê */
            background: linear-gradient(-45deg, #f0f9ff, #e0f2fe, #fdf4ff, #fffbeb, #e0f2fe);
            background-size: 400% 400%;
            animation: daylightGradient 20s ease infinite;
            color: #0f172a;
            font-family: 'Cormorant Garamond', serif;
            overflow: hidden; 
            position: relative;
            height: 100vh;
            width: 100vw;
        }

        @keyframes daylightGradient {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* --- HỆ THỐNG SÔNG NÚI CUỘN TRÔI (MÀU TƯƠI SÁNG) --- */
        .landscape {
            position: absolute;
            bottom: 0; left: 0;
            width: 300vw; 
            height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* Núi xa (Màu xanh lơ nhạt, hòa vào sương) */
        .mountain-back {
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 300" preserveAspectRatio="none"><path d="M0,300 L150,120 L300,220 L500,80 L700,250 L850,150 L1000,300 Z" fill="%23bae6fd"/></svg>') repeat-x bottom;
            background-size: 100vw 45vh;
            animation: panLeft 50s linear infinite;
            opacity: 0.6;
        }

        /* Núi giữa (Xanh ngọc pha chút rêu sáng) */
        .mountain-mid {
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 300" preserveAspectRatio="none"><path d="M0,300 L200,180 L350,100 L550,280 L750,120 L900,200 L1000,300 Z" fill="%237dd3fc"/></svg>') repeat-x bottom;
            background-size: 100vw 35vh;
            animation: panLeft 35s linear infinite;
            opacity: 0.7;
        }

        /* Núi gần (Đậm hơn một chút để tạo chiều sâu) */
        .mountain-front {
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 300" preserveAspectRatio="none"><path d="M0,300 L100,220 L250,150 L400,280 L600,180 L800,260 L1000,300 Z" fill="%2338bdf8"/></svg>') repeat-x bottom;
            background-size: 100vw 20vh;
            animation: panLeft 20s linear infinite;
            opacity: 0.9;
        }

        /* Lớp sương mù trắng xóa, bồng bềnh dưới chân núi */
        .mist-layer {
            position: absolute;
            bottom: 0; left: 0; width: 100vw; height: 40vh;
            background: linear-gradient(to top, rgba(255, 255, 255, 1) 10%, rgba(255, 255, 255, 0.7) 40%, transparent 100%);
            filter: blur(10px);
            z-index: 2;
            animation: breatheMist 6s infinite alternate ease-in-out;
        }

        /* Hào quang rực rỡ từ trên trời chiếu xuống */
        .god-rays {
            position: absolute;
            top: -20%; left: 0; width: 100vw; height: 100vh;
            background: radial-gradient(circle at 50% 0%, rgba(253, 230, 138, 0.4) 0%, transparent 60%);
            z-index: 0;
            pointer-events: none;
        }

        @keyframes panLeft {
            0% { transform: translateX(0); }
            100% { transform: translateX(-100vw); }
        }

        @keyframes breatheMist {
            0% { opacity: 0.8; height: 35vh; }
            100% { opacity: 1; height: 45vh; }
        }

        /* --- HỆ THỐNG LINH KHÍ ĐOM ĐÓM & CÁNH HOA TƯƠI SÁNG --- */
        #particle-container {
            position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
            z-index: 3; pointer-events: none;
        }

        .orb {
            position: absolute;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 0 15px 4px rgba(251, 191, 36, 0.8), 0 0 30px 8px rgba(255, 255, 255, 0.6);
            opacity: 0;
            animation: floatOrb linear infinite;
        }

        .petal {
            position: absolute;
            font-size: 1.2rem;
            filter: drop-shadow(0 0 5px rgba(255,255,255,0.8));
            animation: fallPetal linear infinite;
        }

        @keyframes floatOrb {
            0% { transform: translateY(100vh) scale(0.5); opacity: 0; }
            20% { opacity: 0.8; }
            80% { opacity: 0.8; }
            100% { transform: translateY(-10vh) scale(1.5); opacity: 0; }
        }

        @keyframes fallPetal {
            0% { transform: translateY(-10vh) rotate(0deg) translateX(0); opacity: 0; }
            20% { opacity: 0.9; }
            80% { opacity: 0.9; }
            100% { transform: translateY(110vh) rotate(360deg) translateX(50px); opacity: 0; }
        }

        /* --- CONTAINER HIỂN THỊ CHỮ VÀ MINH HỌA --- */
        #scene-container {
            position: absolute; top: 0; left: 0; width: 100vw; height: 100vh;
            display: flex; align-items: center; justify-content: center;
            z-index: 10;
        }

        .scene-layout {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 85%; max-width: 1200px;
            opacity: 0;
            pointer-events: none;
            position: absolute;
            transition: all 1.5s cubic-bezier(0.25, 1, 0.5, 1);
        }

        .scene-layout.active { opacity: 1; pointer-events: auto; }
        .scene-layout.fade-out { opacity: 0; filter: blur(10px); transform: scale(1.1); }

        .align-left { flex-direction: row; transform: translateX(-40px); }
        .align-right { flex-direction: row-reverse; transform: translateX(40px); }
        .align-center { flex-direction: column; justify-content: center; text-align: center; transform: translateY(30px); }
        
        .scene-layout.active.align-left, 
        .scene-layout.active.align-right,
        .scene-layout.active.align-center { transform: translate(0, 0); }

        .text-box { flex: 1.2; padding: 0 40px; }
        .illust-box { flex: 0.8; display: flex; justify-content: center; align-items: center; }

        /* Typography cho nền sáng: Chữ sẫm màu, viền sáng trắng bọc ngoài */
        .epic-title {
            font-family: 'Philosopher', sans-serif; font-size: 4rem; font-weight: 700;
            background-image: linear-gradient(to right, #b45309, #ea580c, #b45309);
            -webkit-background-clip: text; color: transparent;
            text-shadow: 2px 2px 0px #fff, 0 0 30px rgba(255, 255, 255, 1); 
            letter-spacing: 5px; margin-bottom: 15px;
        }
        
        .epic-subtitle { font-size: 2rem; color: #0284c7; font-style: italic; letter-spacing: 2px; font-weight: 600; text-shadow: 1px 1px 0px #fff, 0 0 10px rgba(255,255,255,0.8); }

        .story-text {
            font-size: 2.3rem; line-height: 1.7; color: #1e293b; font-weight: 700;
            /* Đổ bóng trắng dày để chữ không bị chìm vào núi */
            text-shadow: 2px 2px 0px #fff, -2px -2px 0px #fff, 2px -2px 0px #fff, -2px 2px 0px #fff, 0 0 20px rgba(255,255,255,1);
        }

        .name-highlight {
            font-family: 'Philosopher', sans-serif; font-size: 5rem; font-weight: 700;
            color: #be123c; text-shadow: 2px 2px 0px #fff, 0 0 40px rgba(255, 255, 255, 1), 0 0 20px rgba(190, 18, 60, 0.5);
            letter-spacing: 3px; animation: pulseName 2s infinite alternate; margin-top: 20px;
        }

        @keyframes pulseName {
            from { transform: scale(1); }
            to { transform: scale(1.05); text-shadow: 2px 2px 0px #fff, 0 0 50px rgba(251, 191, 36, 0.8), 0 0 30px rgba(190, 18, 60, 0.8); }
        }

        /* Hư ảnh phát sáng (Glow Artifacts) */
        .glowing-artifact {
            font-size: 11rem; line-height: 1;
            filter: drop-shadow(0 0 40px rgba(251, 191, 36, 1)) drop-shadow(0 0 60px rgba(255, 255, 255, 0.9));
            animation: artifactFloat 4s infinite ease-in-out alternate;
        }

        @keyframes artifactFloat {
            0% { transform: translateY(0) rotate(-5deg); filter: drop-shadow(0 0 30px rgba(251, 191, 36, 0.8)); }
            100% { transform: translateY(-30px) rotate(5deg); filter: drop-shadow(0 0 60px rgba(251, 191, 36, 1)) drop-shadow(0 0 30px rgba(255, 255, 255, 1)); }
        }

        /* --- NGỌC GIẢN CUỐI CÙNG (Kính mờ trắng tinh khôi) --- */
        #final-card {
            background: rgba(255, 255, 255, 0.75); padding: 50px; border-radius: 20px;
            border: 2px solid rgba(251, 191, 36, 0.6);
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.1), inset 0 0 30px rgba(255, 255, 255, 1);
            backdrop-filter: blur(15px); text-align: center;
            display: none; opacity: 0; transform: translateY(30px) scale(0.9);
            transition: all 2s cubic-bezier(0.25, 1, 0.5, 1);
            position: relative; z-index: 20; max-width: 800px;
        }
        
        #final-card.show { display: block; }
        #final-card.visible { opacity: 1; transform: translateY(0) scale(1); }

        .poem-title { font-family: 'Philosopher', sans-serif; font-size: 2.8rem; color: #d97706; margin-bottom: 25px; text-shadow: 0 0 15px rgba(255, 255, 255, 1); }
        .poem-text { font-size: 2rem; line-height: 1.8; color: #0f172a; font-weight: 700; font-style: italic; }
        .signature { margin-top: 40px; font-size: 1.8rem; color: #0284c7; text-align: right; font-weight: 700; }

        #skip-btn {
            position: fixed; bottom: 20px; right: 20px; z-index: 100;
            background: rgba(255, 255, 255, 0.8); border: 2px solid #38bdf8;
            padding: 12px 25px; border-radius: 30px; color: #0284c7;
            font-family: 'Philosopher', sans-serif; font-size: 1.2rem; font-weight: 700;
            cursor: pointer; backdrop-filter: blur(5px); transition: all 0.3s;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }
        #skip-btn:hover { background: #fff; transform: translateY(-2px); box-shadow: 0 8px 20px rgba(56, 189, 248, 0.4); }
    </style>
</head>
<body>

    <!-- Lớp hào quang chiếu sáng -->
    <div class="god-rays"></div>

    <!-- Lớp cảnh sắc núi non tươi sáng cuộn trôi -->
    <div class="landscape mountain-back"></div>
    <div class="landscape mountain-mid"></div>
    <div class="landscape mountain-front"></div>
    
    <!-- Sương mù bồng lai -->
    <div class="mist-layer"></div>

    <!-- Hạt linh khí phát sáng & Cánh hoa -->
    <div id="particle-container"></div>

    <!-- Vùng chiếu kịch bản -->
    <div id="scene-container"></div>

    <!-- Ngọc giản xuất hiện cuối cùng -->
    <div id="final-card">
        <h2 class="poem-title">TÂM Ý NGỌC GIẢN 📜</h2>
        <div class="poem-text">
            Tuế nguyệt xoay vần thêm một thu,<br>
            Chúc cho đạo hữu thuận đường tu.<br>
            Bình cảnh phá vỡ, tài nguyên tiến,<br>
            Linh thạch đầy túi, bớt âu lo.<br><br>
            Rảnh rỗi vân du nếm mỹ vị,<br>
            Mời ta lẩu nướng, chén linh trà.<br>
            Đạo tâm kiên định, không lùi bước,<br>
            Tiên đồ rộng mở, tựa mây xa!
        </div>
        <p class="signature"><br>Ngô Hiệp lão quỷ</p>
    </div>

    <button id="skip-btn" onclick="skipToEnd()">Lướt Qua Huyễn Cảnh ⏭</button>

    <script>
        // --- 1. TẠO LINH KHÍ ĐOM ĐÓM & CÁNH HOA TƯƠI SÁNG ---
        function createParticles() {
            const container = document.getElementById('particle-container');
            
            // Tạo đom đóm sáng
            setInterval(() => {
                const orb = document.createElement('div');
                orb.className = 'orb';
                const size = Math.random() * 5 + 3;
                orb.style.width = size + 'px';
                orb.style.height = size + 'px';
                orb.style.left = Math.random() * 100 + 'vw';
                orb.style.animationDuration = (Math.random() * 15 + 10) + 's';
                container.appendChild(orb);
                setTimeout(() => { orb.remove(); }, 25000);
            }, 400); 

            // Tạo cánh hoa rơi (🌸, 💮, 🍃, ✨)
            const petals = ['🌸', '💮', '✨', '☁️'];
            setInterval(() => {
                const petal = document.createElement('div');
                petal.className = 'petal';
                petal.innerText = petals[Math.floor(Math.random() * petals.length)];
                petal.style.left = Math.random() * 100 + 'vw';
                petal.style.animationDuration = (Math.random() * 12 + 8) + 's';
                container.appendChild(petal);
                setTimeout(() => { petal.remove(); }, 20000);
            }, 800);
        }
        createParticles();

        // --- 2. KỊCH BẢN CHỮ ĐAN CHÉO (CÓ MINH HỌA) ---
        const scenes = [
            { 
                align: 'center', 
                text: `<div class="epic-title">THIÊN ĐỊA BIẾN HẢI</div><div class="epic-subtitle">Quyển 1: Tiên Nhân Giáng Thế</div>`, 
                illu: ``, 
                duration: 5000 
            },
            { 
                align: 'left', 
                text: `<div class="story-text">Thuở hồng hoang vỡ lở, hỗn loạn sơ khai, vạn vật đều ấp ủ mộng trường sinh bất lão...</div>`, 
                illu: `<div class="glowing-artifact">☯</div>`, 
                duration: 4500 
            },
            { 
                align: 'right', 
                text: `<div class="story-text">Đại đạo ba ngàn, kẻ cầu đạo nhiều như cá diếc qua sông. Người đắc đạo lại hiếm như phù dung sớm nở tối tàn.</div>`, 
                illu: `<div class="glowing-artifact">🪷</div>`, 
                duration: 5000 
            },
            { 
                align: 'left', 
                text: `<div class="story-text">Tu tiên vốn là nghịch thiên cải mệnh, giẫm lên lôi kiếp, đạp phá cửu tuyền.</div>`, 
                illu: `<div class="glowing-artifact">⚡</div>`, 
                duration: 4500 
            },
            { 
                align: 'right', 
                text: `<div class="story-text">Tuế nguyệt vô tình, ngàn năm chớp mắt đã hóa bụi mờ... Thế nhưng, giữa dòng tinh hà vô tận ấy...</div>`, 
                illu: `<div class="glowing-artifact">✨</div>`, 
                duration: 5000 
            },
            { 
                align: 'left', 
                text: `<div class="story-text">Khí thế bễ nghễ, uy trấn Bát Hoang. Một kiếm vung ra, sương hàn lạnh buốt mười bốn châu!</div>`, 
                illu: `<div class="glowing-artifact">⚔️</div>`, 
                duration: 5000 
            },
            { 
                align: 'center', 
                text: `<div class="story-text" style="font-size:2rem; margin-bottom: 10px;">Vạn vạn tu sĩ đều cúi đầu bái phục, kính cẩn tôn xưng...</div><div class="name-highlight">NGỌC KHÁNH THƯỢNG NHÂN</div>`, 
                illu: ``, 
                duration: 6000 
            },
            { 
                align: 'right', 
                text: `<div class="story-text">Hôm nay, tử khí đông lai, thụy quang phủ chiếu. Chính là kỉ niệm sinh thần giáng thế của người!</div>`, 
                illu: `<div class="glowing-artifact">🐉</div>`, 
                duration: 5000 
            }
        ];

        let currentScene = 0;
        let sceneTimeout = null;
        let isSkipped = false;
        const container = document.getElementById('scene-container');

        function playNextScene() {
            if (isSkipped) return;
            if (currentScene >= scenes.length) {
                showFinalCard();
                return;
            }

            const data = scenes[currentScene];
            
            const layout = document.createElement('div');
            layout.className = `scene-layout align-${data.align}`;
            
            if(data.align === 'center') {
                layout.innerHTML = `<div class="text-box" style="text-align: center;">${data.text}</div>`;
            } else {
                layout.innerHTML = `
                    <div class="text-box" style="text-align: ${data.align === 'left' ? 'left' : 'right'};">${data.text}</div>
                    <div class="illust-box">${data.illu}</div>
                `;
            }

            container.innerHTML = ''; 
            container.appendChild(layout);

            setTimeout(() => { if(!isSkipped) layout.classList.add('active'); }, 100);

            sceneTimeout = setTimeout(() => {
                if(isSkipped) return;
                layout.classList.remove('active');
                layout.classList.add('fade-out');
                
                setTimeout(() => {
                    currentScene++;
                    playNextScene();
                }, 1200); 
            }, data.duration);
        }

        function showFinalCard() {
            container.style.display = 'none'; 
            document.getElementById('skip-btn').style.display = 'none';
            
            const card = document.getElementById('final-card');
            card.classList.add('show');
            setTimeout(() => { card.classList.add('visible'); }, 100);
        }

        function skipToEnd() {
            isSkipped = true;
            clearTimeout(sceneTimeout);
            showFinalCard();
        }

        setTimeout(() => { playNextScene(); }, 1000);
    </script>
</body>
</html>
